{
  "name": "Autoclip Design Tokens — Aurora Glass",
  "description": "Mobile-first (390px) design system for the Autoclip video-clipping app, rebuilt from zero. Deep space-dark aurora background, electric violet→fuchsia gradient accents, glassmorphism surfaces, native-app shell with floating tab bar.",
  "color": {
    "background": { "value": "#0B0B14", "usage": "app background (radial gradient to #12121F)" },
    "surface": { "value": "rgba(255,255,255,0.04)", "usage": "glass cards — static, no blur on large surfaces" },
    "surfaceChrome": { "value": "rgba(255,255,255,0.06) + backdrop-blur-xl", "usage": "header/tab bar/dialog chrome only" },
    "border": { "value": "rgba(255,255,255,0.10)", "usage": "glass card borders" },
    "borderHighlight": { "value": "rgba(255,255,255,0.20)", "usage": "inner top highlight on glass" },
    "textPrimary": { "value": "#F4F4F5", "usage": "headings, titles" },
    "textSecondary": { "value": "#A1A1AA", "usage": "body, labels" },
    "textMuted": { "value": "#71717A", "usage": "hints, timestamps" },
    "gradient": {
      "primary": { "value": "linear-gradient(135deg, #8B5CF6, #D946EF)", "usage": "CTA buttons, active states, logo tile, score badges" },
      "heroText": { "value": "bg-clip-text transparent, #A78BFA → #E879F9", "usage": "hero headline words" },
      "progressLine": { "value": "#8B5CF6 → #D946EF", "usage": "pipeline progress line, sliders" }
    },
    "accentSecondary": { "value": "#22D3EE", "token": "cyan-400", "usage": "sparingly — live dot, info chips" },
    "success": { "value": "#10B981", "token": "emerald-500", "usage": "done state, engine online" },
    "danger": { "value": "#EF4444", "token": "red-500", "usage": "failed state, destructive" }
  },
  "typography": {
    "uiFamily": "Inter (system fallback)",
    "captionFonts": {
      "heavy": ["Inter Black", "Anton", "Archivo Black", "Montserrat Black", "Rubik Black", "Kanit Black", "Alfa Slab One", "Sigmar One", "Oswald", "Bebas Neue", "Poppins ExtraBold", "Lexend ExtraBold", "Passion One Bold", "Titan One", "Luckiest Guy", "Fredoka SemiBold"],
      "expressive": ["Bangers", "Creepster", "Righteous"],
      "handwritten": ["Permanent Marker", "Lobster", "Pacifico"]
    },
    "scale": {
      "display": "28px/800 gradient (hero)",
      "h1": "17px/700",
      "h2": "14px/600 (section titles)",
      "body": "13-14px/400-500",
      "caption": "11px/400",
      "micro": "10px/400 (metadata, chips)",
      "percentReadout": "56px/800 tabular-nums (generate screen)"
    }
  },
  "spacing": {
    "base": 4,
    "cardPadding": "16-20px",
    "sectionGap": "24px",
    "screenPadding": "16px (px-4)",
    "touchTarget": "44px minimum; primary CTA 56px"
  },
  "radius": {
    "chip": "12px",
    "card": "24px (rounded-3xl glass)",
    "phonePreview": "28px",
    "tabBar": "9999px floating pill",
    "pill": "9999px"
  },
  "motion": {
    "pageTransition": "fade+slide-up 240ms cubic-bezier(0.22,1,0.36,1)",
    "stagger": "60ms card entrance increments",
    "press": "active:scale-[0.95]",
    "shimmer": "violet-tinted skeleton loop",
    "radarPing": "engine status pulse 2s",
    "stagePulse": "current pipeline node gradient pulse",
    "ctaRing": "animated gradient border on primary CTA",
    "presetAnimations": {
      "karaoke": "word highlight follows speech timing",
      "pop": "scale 0→115%→100% in 220ms",
      "bounce": "scaleY 0→112%→92%→100% in 420ms",
      "wobble": "rotation ±6° oscillation 600ms",
      "rainbow": "hue cycle per word 400ms",
      "typewriter": "alpha reveal synced to word starts",
      "slide": "move from -60% x to center in 240ms",
      "elastic": "scale 60→110→90→105→100% in 460ms"
    },
    "reducedMotion": "all keyframes disabled via prefers-reduced-motion"
  },
  "layout": {
    "maxWidth": "448px (max-w-md) centered",
    "header": "fixed, 64px glass, gradient logo tile, engine-status radar pill",
    "tabBar": "floating detached glass pill, 2 tabs (Create/Library), animated indicator, safe-area bottom",
    "generateScreen": "full-screen, tab bar hidden, pipeline viz hero",
    "videoAspect": { "9:16": "1080x1920", "1:1": "1080x1080", "4:5": "1080x1350", "16:9": "1920x1080" }
  },
  "iconography": {
    "library": "lucide-react",
    "strokeWidth": 1.5,
    "sizes": { "inline": 12, "control": 16, "hero": 20 }
  }
}
